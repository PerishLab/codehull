upstream api { server ${API_UPSTREAM}; }

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/(@grant|actor|asset|batch|column|comment|email|health|issue|key|label|login|milestone|mirror|note|org|package|project|pull|query|reaction|register|release|repo|review|run|runner|secret|shield|team|token|topic|variable)(/|$) {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { try_files $uri /index.html; }
}
